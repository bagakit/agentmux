{
  "manifest_version": 3,
  "name": "AgentMux Shared Tab",
  "version": "0.1.0",
  "minimum_chrome_version": "125",
  "description": "Share one existing tab with AgentMux and revoke it from this popup.",
  "permissions": ["debugger", "activeTab", "tabs", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Share with AgentMux" }
}
