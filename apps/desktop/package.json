{
  "name": "@agentmux/desktop",
  "productName": "AgentMux",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev-desktop.mjs",
    "dev:web": "vite --config vite.web.config.ts --host 127.0.0.1",
    "build": "electron-vite build",
    "package:mac": "pnpm build && pnpm --filter @agentmux/core build && node scripts/package-macos.mjs",
    "package:mac:install": "pnpm package:mac -- --install",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "measure:desktop": "pnpm build && node scripts/measure-desktop-resources.mjs"
  },
  "dependencies": {
    "@agentmux/core": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^2.1.7",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.1.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
}
