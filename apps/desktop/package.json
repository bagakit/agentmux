{
  "name": "@agentmux/desktop",
  "productName": "AgentMux",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "build:workspace-move-helper": "node scripts/build-workspace-move-helper.mjs",
    "build:brand-assets": "node scripts/build-brand-assets.mjs",
    "predev": "pnpm --filter @agentmux/connectors... build && pnpm build:workspace-move-helper && pnpm build:brand-assets",
    "dev": "node scripts/dev-desktop.mjs",
    "dev:web": "vite --config vite.web.config.ts --host 127.0.0.1",
    "build:gallery": "vite build --config vite.gallery.config.ts",
    "prebuild": "pnpm --filter @agentmux/connectors... build && pnpm --filter @agentmux/git build && pnpm build:workspace-move-helper && pnpm build:brand-assets",
    "build": "pnpm --filter @agentmux/mobile build && electron-vite build && node scripts/build-renderer-release.mjs && node scripts/copy-mobile.mjs",
    "package:mac": "node scripts/package-macos.mjs",
    "package:mac:install": "node scripts/package-macos.mjs --install",
    "probe:file-editing": "node scripts/probe-file-editing.mjs",
    "report:package": "node scripts/report-desktop-package.mjs",
    "audit:features": "node scripts/audit-feature-history.mjs",
    "capture:visual": "node scripts/verify-agent-region-identity-menu.mjs --visual-only",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "measure:desktop": "pnpm build && node scripts/measure-desktop-resources.mjs"
  },
  "dependencies": {
    "@agentmux/client-ui": "workspace:*",
    "@agentmux/core": "workspace:*",
    "@agentmux/demand": "workspace:*",
    "@agentmux/git": "workspace:*",
    "@agentmux/layout": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@excalidraw/excalidraw": "0.18.1",
    "@floating-ui/dom": "1.8.0",
    "@monaco-editor/react": "^4.7.0",
    "@noble/hashes": "2.4.0",
    "@plantuml/core": "1.2026.8",
    "@radix-ui/react-context-menu": "2.3.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-roving-focus": "1.1.15",
    "@tanstack/react-virtual": "3.14.13",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-unique-id": "3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@viz-js/viz": "3.31.0",
    "@xterm/addon-fit": "0.12.0-beta.300",
    "@xterm/addon-search": "0.17.0-beta.300",
    "@xterm/addon-unicode11": "0.10.0-beta.300",
    "@xterm/addon-web-links": "0.13.0-beta.300",
    "@xterm/addon-webgl": "0.20.0-beta.299",
    "@xterm/headless": "^5.5.0",
    "@xterm/xterm": "6.1.0-beta.303",
    "@xyflow/react": "12.12.0",
    "dompurify": "3.4.16",
    "jsonc-parser": "3.3.1",
    "lucide-react": "^0.468.0",
    "luxon": "3.7.2",
    "mermaid": "12.1.0",
    "monaco-editor": "^0.56.0",
    "papaparse": "5.5.3",
    "pdfjs-dist": "6.3.289",
    "prettier": "3.9.10",
    "qrcode.react": "4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^2.1.7",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shlex": "^3.0.0",
    "smol-toml": "1.9.1",
    "three": "0.180.0",
    "tldts": "7.4.10",
    "unified": "^11.0.5",
    "vega": "6.4.0",
    "vega-interpreter": "2.3.2",
    "vega-lite": "6.5.0",
    "ws": "8.21.3",
    "yaml": "2.9.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0",
    "@agentmux/connectors": "workspace:*"
  },
  "devDependencies": {
    "@electron/osx-sign": "2.7.1",
    "@types/luxon": "3.7.6",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "@types/papaparse": "5.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.180.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.7.7",
    "electron-vite": "^5.0.0",
    "happy-dom": "^20.14.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
}
