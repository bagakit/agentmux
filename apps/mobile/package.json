{
  "name": "@agentmux/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --config vitest.config.ts",
    "native:add:ios": "cap add ios",
    "native:add:android": "cap add android",
    "native:sync": "cap sync"
  },
  "dependencies": {
    "@agentmux/core": "workspace:*",
    "@agentmux/client-ui": "workspace:*",
    "@agentmux/demand": "workspace:*",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.0.0",
    "@capacitor/clipboard": "8.0.0",
    "@capacitor/keyboard": "8.0.4",
    "@capawesome/capacitor-file-picker": "8.0.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@xterm/xterm": "6.1.0-beta.303",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@agentmux/relay": "workspace:*"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "happy-dom": "^20.14.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.0"
  }
}
