{
  "name": "@agentmux/demand",
  "version": "0.1.0",
  "description": "Host-neutral filesystem Demand store and CLI for AgentMux",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/bagakit/agentmux.git",
    "directory": "packages/demand"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./store": {
      "types": "./dist/src/demand-store.d.ts",
      "import": "./dist/src/demand-store.js"
    },
    "./types": {
      "types": "./dist/src/demand-types.d.ts",
      "import": "./dist/src/demand-types.js"
    },
    "./cli": {
      "types": "./dist/src/cli.d.ts",
      "import": "./dist/src/cli.js"
    },
    "./goals": {
      "types": "./dist/src/goals.d.ts",
      "import": "./dist/src/goals.js"
    },
    "./goal-grounding": {
      "types": "./dist/src/goal-grounding.d.ts",
      "import": "./dist/src/goal-grounding.js"
    },
    "./delegations": {
      "types": "./dist/src/delegations.d.ts",
      "import": "./dist/src/delegations.js"
    },
    "./dispatch": {
      "types": "./dist/src/dispatch.d.ts",
      "import": "./dist/src/dispatch.js"
    },
    "./content-references": {
      "types": "./dist/src/content-references.d.ts",
      "import": "./dist/src/content-references.js"
    },
    "./goal-ticket-crypto": {
      "types": "./dist/src/goal-ticket-crypto.d.ts",
      "import": "./dist/src/goal-ticket-crypto.js"
    },
    "./goal-plan": {
      "types": "./dist/src/goal-plan.d.ts",
      "import": "./dist/src/goal-plan.js"
    },
    "./relations": {
      "types": "./dist/src/relations.d.ts",
      "import": "./dist/src/relations.js"
    },
    "./goal-patrol": {
      "types": "./dist/src/goal-patrol.d.ts",
      "import": "./dist/src/goal-patrol.js"
    },
    "./responsibility": {
      "types": "./dist/src/responsibility.d.ts",
      "import": "./dist/src/responsibility.js"
    }
  },
  "bin": {
    "agentmux-demand": "./dist/bin/agentmux-demand.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/bin/agentmux-demand.js",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@agentmux/identity": "workspace:*",
    "fs-native-extensions": "1.5.1"
  }
}
