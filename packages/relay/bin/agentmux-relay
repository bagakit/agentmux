#!/usr/bin/env node
import { runRelayGatewayCli } from '../dist/gateway-cli.js'
void runRelayGatewayCli(process.argv.slice(2)).catch(error => {
  const code = typeof error?.code === 'string' && error.code.startsWith('MESH_STATE_') ? error.code : 'RELAY_FAILED'
  process.stderr.write(JSON.stringify({ error: { code, message: error instanceof Error ? error.message : String(error),
    ...(code.startsWith('MESH_STATE_') && typeof error.operationId === 'string' ? { operationId: error.operationId } : {}) } }) + '\n')
  process.exitCode = 1
})
