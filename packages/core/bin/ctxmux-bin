#!/bin/sh
amx_binary="$1"
shift
case "$(uname -s)/$(uname -m)" in
  Darwin/arm64) amx_platform=darwin-arm64 ;;
  Linux/x86_64) amx_platform=linux-x64 ;;
  *) printf '%s\n' 'AgentMux has no qualified ctxmux artifacts for this host.' >&2; exit 1 ;;
esac
amx_directory="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
# POSIX exec preserves native PID, signals, terminal and caller-owned readiness descriptors.
exec "$amx_directory/../vendor/ctxmux/$amx_platform/bin/$amx_binary" "$@"
