    "measure:daemon": "pnpm build && node scripts/measure-daemon-resources.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/shell-quote": "^1.7.5",
    "typescript": "^5.9.0",
