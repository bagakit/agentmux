{
  "name": "@agentmux/core",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentmuxd": "./bin/agentmuxd.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "dependencies": {
    "execa": "^9.6.0",
