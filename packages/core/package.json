  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm build && vitest run --exclude test/reliability-stress.integration.test.ts --exclude test/security-fuzz.test.ts",
    "test:real-codex": "pnpm build && AGENTMUX_REAL_CODEX_E2E=1 vitest run --maxWorkers=1 test/real-codex.integration.test.ts",
    "test:security": "pnpm build && vitest run test/acp-adapter.test.ts test/agent-session-store-limits.test.ts test/client-event-publisher.test.ts test/control-host.test.ts test/hook-server.test.ts test/managed-hook-installer.test.ts",
    "test:fuzz": "pnpm build && vitest run test/security-fuzz.test.ts",
    "test:reliability": "pnpm build && vitest run --maxWorkers=1 test/reliability-stress.integration.test.ts",
    "test:conformance": "pnpm build && vitest run test/runtime-projection.test.ts test/agent-session-store.test.ts && vitest run --maxWorkers=1 test/package-consumer.integration.test.ts",
    "test:benchmark-smoke": "pnpm build && AGENTMUX_BENCHMARK_SMOKE=1 vitest run --maxWorkers=1 test/daemon-cutover-benchmark-smoke.integration.test.ts",
    "benchmark:daemon-cutover": "pnpm build && node scripts/run-daemon-cutover-benchmark.mjs",
    "benchmark:daemon-cutover:smoke": "pnpm build && node scripts/run-daemon-cutover-benchmark.mjs --smoke",
    "postinstall": "node bin/install-ctxmux.mjs"
  },
  "devDependencies": {
    "@ctxmux/sdk": "file:vendor/ctxmux/darwin-arm64/ctxmux-sdk-0.0.0.tgz",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
