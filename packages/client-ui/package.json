{
  "name": "@agentmux/client-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    "./agent-icons/*": "./src/assets/agent-icons/*",
    "./brand/*": "./brand/*",
    "./input": {
      "types": "./src/input/index.ts",
      "browser": "./src/input/index.ts",
      "import": "./dist/input/index.js"
    },
    "./input/styles.css": "./src/input/input.css",
    ".": {
      "types": "./src/index.ts",
      "browser": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./components/*": {
      "types": "./src/components/*.tsx",
      "browser": "./src/components/*.tsx",
      "import": "./dist/components/*.js"
    },
    "./components/SelectionField": {
      "types": "./src/components/SelectionField.tsx",
      "browser": "./src/components/SelectionField.tsx",
      "import": "./dist/components/SelectionField.js"
    },
    "./components/SearchChoiceDialog": {
      "types": "./src/components/SearchChoiceDialog.tsx",
      "browser": "./src/components/SearchChoiceDialog.tsx",
      "import": "./dist/components/SearchChoiceDialog.js"
    },
    "./styles/selection-field.css": "./src/styles/selection-field.css",
    "./styles/search-choice.css": "./src/styles/search-choice.css",
    "./patterns/agent-work-location": {
      "types": "./src/patterns/agent-work-location.tsx",
      "browser": "./src/patterns/agent-work-location.tsx",
      "import": "./dist/patterns/agent-work-location.js"
    },
    "./patterns/agent-work-location.css": "./src/patterns/agent-work-location.css",
    "./terminal/*": {
      "types": "./src/terminal/*.ts",
      "browser": "./src/terminal/*.ts",
      "import": "./dist/terminal/*.js"
    },
    "./conversation-send-receipts": {
      "types": "./src/lib/conversation-send-receipts.ts",
      "browser": "./src/lib/conversation-send-receipts.ts",
      "import": "./dist/lib/conversation-send-receipts.js"
    },
    "./*": {
      "types": "./src/lib/*.ts",
      "browser": "./src/lib/*.ts",
      "import": "./dist/lib/*.js"
    },
    "./platform": {
      "types": "./src/platform.tsx",
      "browser": "./src/platform.tsx",
      "import": "./dist/platform.js"
    },
    "./overlay-host": {
      "types": "./src/overlay-host.tsx",
      "browser": "./src/overlay-host.tsx",
      "import": "./dist/overlay-host.js"
    },
    "./styles.css": "./src/styles/index.css",
    "./styles/*": "./src/styles/*",
    "./note/*": {
      "types": "./src/note/*.ts",
      "browser": "./src/note/*.ts",
      "import": "./dist/note/*.js"
    },
    "./components/NoteReader": {
      "types": "./src/components/NoteReader.tsx",
      "browser": "./src/components/NoteReader.tsx",
      "import": "./dist/components/NoteReader.js"
    },
    "./theme/model": {
      "types": "./src/theme/model.ts",
      "browser": "./src/theme/model.ts",
      "import": "./dist/theme/model.js"
    },
    "./theme": {
      "types": "./src/theme/index.ts",
      "browser": "./src/theme/index.ts",
      "import": "./dist/theme/index.js"
    },
    "./icons": {
      "types": "./src/theme/icons.tsx",
      "browser": "./src/theme/icons.tsx",
      "import": "./dist/theme/icons.js"
    },
    "./components/Button": {
      "types": "./src/components/Button.tsx",
      "browser": "./src/components/Button.tsx",
      "import": "./dist/components/Button.js"
    },
    "./components/IconButton": {
      "types": "./src/components/IconButton.tsx",
      "browser": "./src/components/IconButton.tsx",
      "import": "./dist/components/IconButton.js"
    },
    "./styles/buttons.css": "./src/styles/buttons.css",
    "./components/FormRow": {
      "types": "./src/components/FormRow.tsx",
      "browser": "./src/components/FormRow.tsx",
      "import": "./dist/components/FormRow.js"
    },
    "./components/Modal": {
      "types": "./src/components/Modal.tsx",
      "browser": "./src/components/Modal.tsx",
      "import": "./dist/components/Modal.js"
    },
    "./styles/overlays.css": "./src/styles/overlays.css",
    "./components/InlineRenameField": {
      "types": "./src/components/InlineRenameField.tsx",
      "browser": "./src/components/InlineRenameField.tsx",
      "import": "./dist/components/InlineRenameField.js"
    },
    "./styles/semantic-icons.css": "./src/styles/semantic-icons.css",
    "./styles/inline-rename-field.css": "./src/styles/inline-rename-field.css",
    "./styles/theme-defaults.css": "./src/styles/theme-defaults.css",
    "./components/HoverDropdownMenu": {
      "types": "./src/components/HoverDropdownMenu.tsx",
      "browser": "./src/components/HoverDropdownMenu.tsx",
      "import": "./dist/components/HoverDropdownMenu.js"
    },
    "./styles/palette.css": "./src/styles/palette.css"
  },
  "files": [
    "CONTRIBUTING.md",
    "ROADMAP.md",
    "brand",
    "dist",
    "docs/patterns",
    "examples",
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "build": "node scripts/supported-entries.mjs --check && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs && node scripts/generate-theme-defaults.mjs --check",
    "generate:entries": "node scripts/supported-entries.mjs --write",
    "generate:theme": "tsc -p tsconfig.build.json && node scripts/generate-theme-defaults.mjs"
  },
  "dependencies": {
    "@agentmux/core": "workspace:*",
    "@floating-ui/dom": "1.8.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-dismissable-layer": "1.1.19",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-code-block": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "lucide-react": "^0.468.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "remark-directive": "^4.0.0",
    "entities": "7.0.1",
    "unified": "^11.0.5",
    "@tiptap/extension-unique-id": "3.31.3",
    "katex": "0.19.0",
    "remark-math": "6.0.0",
    "highlight.js": "11.12.0",
    "jsonc-parser": "3.3.1",
    "zod": "^4.0.0",
    "svg-pathdata": "^9.0.0",
    "@xterm/addon-unicode11": "0.10.0-beta.300",
    "@xterm/xterm": "6.1.0-beta.303",
    "decode-named-character-reference": "1.3.0",
    "diff": "9.0.0",
    "dompurify": "3.4.16",
    "parse5": "8.0.1"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "happy-dom": "^20.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "@types/katex": "0.16.8"
  }
}
