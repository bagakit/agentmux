{
  "name": "agentmux-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "dev": "pnpm --filter @agentmux/desktop dev",
    "dev:web": "pnpm --filter @agentmux/desktop dev:web",
    "build": "pnpm -r build",
    "package:mac": "pnpm --filter @agentmux/desktop package:mac",
    "package:mac:install": "pnpm --filter @agentmux/desktop package:mac:install",
    "typecheck": "pnpm --filter @agentmux/core build && pnpm -r typecheck",
    "test:fast": "pnpm --filter @agentmux/core build && vitest run --exclude packages/core/test/package-consumer.integration.test.ts",
    "test:native": "pnpm --filter @agentmux/core build && vitest run --maxWorkers=1 packages/core/test/package-consumer.integration.test.ts",
    "test": "pnpm test:fast && pnpm test:native",
    "test:security": "pnpm --filter @agentmux/core build && vitest run packages/core/test/acp-adapter.test.ts packages/core/test/hook-server.test.ts packages/core/test/managed-hook-installer.test.ts packages/core/test/package-consumer.integration.test.ts apps/desktop/test/workspace-files.test.ts apps/desktop/test/browser-view-manager.test.ts",
    "test:chaos": "pnpm --filter @agentmux/core test:chaos",
    "test:nightly": "pnpm test:security && pnpm test:chaos",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
